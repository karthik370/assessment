# Copy this file to .env and fill in the DATABASE_URL.
# For local dev, use a local Postgres instance or Supabase free tier.
# For Vercel deployment, add these in the Vercel dashboard under Environment Variables.

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/ptw_cmms?schema=public"

# NextAuth — generate a strong random secret: openssl rand -base64 32
AUTH_SECRET="replace-this-with-a-strong-random-secret-at-least-32-chars"

# Base URL (used for QR codes) — set to your production URL on Vercel
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Cron secret — any random string, also set in Vercel dashboard
CRON_SECRET="replace-with-random-cron-secret"
